  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "css:build": "tailwindcss -i ./static/css/input.css -o ./static/css/app.css",
    "css:watch": "tailwindcss -i ./static/css/input.css -o ./static/css/app.css --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ogoldmann/cordell.git"
  },
  "keywords": [],
