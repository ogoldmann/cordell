  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ogoldmann/cordell/issues"
  },
  "homepage": "https://github.com/ogoldmann/cordell#readme",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.2",
    "tailwindcss": "^4.3.2"
  }
}
